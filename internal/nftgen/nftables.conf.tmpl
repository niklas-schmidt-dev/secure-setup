#!/usr/sbin/nft -f
# {{.Marker}}
#
# Inbound policy for this host:
#   - the internet reaches nothing except the web ports, and only from Cloudflare's published ranges
#   - administration (SSH) works only over the tailnet interface "{{.AdminInterface}}"
#   - everything else inbound is dropped; outbound is allowed
#
# Cloudflare ranges live in {{.ElementsPath}} and are refreshed daily by a systemd timer.
# Reload after editing:  nft -f /etc/nftables.conf
# Inspect:               nft list ruleset

table inet {{.TableName}}
delete table inet {{.TableName}}

table inet {{.TableName}} {
	set cloudflare_v4 {
		type ipv4_addr
		flags interval
	}

	set cloudflare_v6 {
		type ipv6_addr
		flags interval
	}

	chain input {
		type filter hook input priority filter; policy drop;

		iif "lo" accept
		ct state established,related accept
		ct state invalid drop

		# ICMP the network needs: path MTU discovery, IPv6 neighbour discovery
		icmp type { destination-unreachable, time-exceeded, parameter-problem } accept
		icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem, nd-router-advert, nd-neighbor-solicit, nd-neighbor-advert } accept
{{- if .AllowPing}}
		icmp type echo-request limit rate 10/second accept
		icmpv6 type echo-request limit rate 10/second accept
{{- end}}

		# DHCP replies: cloud providers assign the primary IPv4 address via DHCP
		udp sport 67 udp dport 68 accept

		# Tailscale: direct WireGuard connections (authenticated; relays are used otherwise)
		udp dport {{.TailscaleUDPPort}} accept

		# Administration: only over the tailnet (the counter shows new connections through this rule)
{{- if .TailnetAll}}
		iifname "{{.AdminInterface}}" counter accept
{{- else}}
		iifname "{{.AdminInterface}}" tcp dport { {{.TailnetPortList}} } counter accept
{{- end}}
{{- if .WebPorts}}

		# Web: only Cloudflare's edge may reach the origin
		ip saddr @cloudflare_v4 tcp dport { {{.WebPortList}} } accept
		ip6 saddr @cloudflare_v6 tcp dport { {{.WebPortList}} } accept
{{- end}}
	}

	chain forward {
		type filter hook forward priority filter; policy drop;

		ct state established,related accept
		ct state invalid drop

		# Containers, VMs and the tailnet may be forwarded (container egress, subnet routes)
		iifname != "{{.WANInterface}}" accept
{{- if .WebPorts}}

		# Published container ports: the internet reaches them only through Cloudflare on the web ports
		iifname "{{.WANInterface}}" meta l4proto tcp ip saddr @cloudflare_v4 ct original proto-dst { {{.WebPortList}} } accept
		iifname "{{.WANInterface}}" meta l4proto tcp ip6 saddr @cloudflare_v6 ct original proto-dst { {{.WebPortList}} } accept
{{- end}}
	}

	chain output {
		type filter hook output priority filter; policy accept;
	}
}

include "{{.ElementsPath}}"
