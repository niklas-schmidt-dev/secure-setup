# Drives `secure-setup here` (the wizard) inside the e2e server container.
# The existing-network plan skips the Tailscale screen; the firewall screen
# and review are answered with defaults, then the run waits for a login,
# which test/e2e/run-here.sh provides from the client container.
set timeout 60
# The server's private address, passed in by run-here.sh, dots escaped.
set prv [string map {. {\.}} $env(E2E_PRIVATE_IP)]
log_user 1
spawn secure-setup here -f /root/plan-login.json
stty rows 40 columns 120 < $spawn_out(slave,name)
# The first field of the firewall page: the note above it scrolls away when
# the page is taller than the terminal.
expect {
  -re {Web traffic} { puts "\nWALK: firewall screen" }
  timeout { puts "\nWALK: FAIL no firewall screen"; exit 1 }
}
# Web traffic select -> enter (https), extra ports (prefilled 8080) -> enter,
# ping -> enter, password login -> enter, rollback -> enter, confirmation ->
# enter, then the page with system update and reboot (No from the plan) ->
# enter, enter
foreach i {1 2 3 4 5 6 7 8} { sleep 0.4; send "\r" }
expect {
  -re {Review} { puts "\nWALK: review screen" }
  timeout { puts "\nWALK: FAIL no review screen"; exit 1 }
}
expect {
  -re {Confirmation.*a new login from another device} { puts "\nWALK: review shows login confirmation" }
  timeout { puts "\nWALK: FAIL review lacks confirmation line"; exit 1 }
}
expect {
  -re {Apply this setup now} { sleep 0.4; send "y" }
  timeout { puts "\nWALK: FAIL no apply question"; exit 1 }
}
set timeout 120
expect {
  -re "ssh root@$prv" { puts "\nWALK: waiting for login" }
  timeout { puts "\nWALK: FAIL run never asked for a login"; exit 1 }
}
expect {
  -re {This machine is locked down} { puts "\nWALK: done screen" }
  -re {Setup did not finish} { puts "\nWALK: FAIL run failed"; exit 1 }
  timeout { puts "\nWALK: FAIL no done screen"; exit 1 }
}
send "q"
expect eof
