# Runs the secure-setup binary against the throwaway server.
FROM debian:bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates openssh-client iproute2 netcat-openbsd \
 && rm -rf /var/lib/apt/lists/*
CMD ["sleep", "infinity"]
